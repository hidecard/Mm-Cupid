# Database Configuration
# Use 'turso' for SQLite/Turso or 'mysql' for MySQL
DB_TYPE=turso

# Turso Configuration (used when DB_TYPE=turso)
# For local development, use file:dev.db
# For production Turso cloud: use https://your-db.turso.io with auth token
TURSO_URL=file:dev.db
TURSO_AUTH_TOKEN=


# JWT Configuration
JWT_SECRET=mm_cupid_dev_secret_2026
JWT_EXPIRES_IN=7d

# Pusher Configuration (Real-time Chat)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Server
PORT=3000

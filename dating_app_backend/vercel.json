{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "nodejs20.x"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ],
  "env": {
    "DB_TYPE": "turso",
    "TURSO_URL": "file:dev.db"
  }
}

# Database Configuration
# Use 'turso' for SQLite/Turso or 'mysql' for MySQL
DB_TYPE=turso

# Turso Configuration (used when DB_TYPE=turso)
TURSO_URL=file:dev.db
TURSO_AUTH_TOKEN=

# MySQL Configuration (used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dating_app

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# Pusher Configuration (Real-time Chat)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Server
PORT=3000
